---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Star from "../components/Star.astro";
import FilterChips from "../components/FilterChips.astro";
import Lightbox from "../components/Lightbox.astro";
import Carousel from "../components/Carousel.astro";
import { cosplays } from "../data/cosplays";

const categories = [...new Set(cosplays.map((cosplay) => cosplay.category))];
const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout
  title="Cosplays · Ice Fire Cosplay"
  description="Portfolio de cosplays de Camila, Ice Fire Cosplay: personajes de videojuegos, series y animación."
>
  <Header />
  <main>
    <section class="relative overflow-hidden pb-14 pt-32 lg:pb-20 lg:pt-40">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-40 left-1/2 h-[30rem] w-[44rem] -translate-x-1/2 rounded-full bg-navy/35 blur-[130px]"></div>
        <Star class="absolute right-[12%] top-[34%] w-2.5 text-ice/40 animate-twinkle" />
        <Star class="absolute bottom-[16%] left-[7%] w-2 text-ice/30 animate-twinkle [animation-delay:1.6s]" />
      </div>

      <div class="relative mx-auto max-w-7xl px-6">
        <nav aria-label="Ruta" class="flex items-center gap-3 text-[0.6rem] uppercase tracking-[0.36em] text-white/40">
          <a href="/" class="transition-colors duration-300 hover:text-ice">Inicio</a>
          <Star class="w-1.5 text-ice/50" />
          <span aria-current="page" class="text-ice/80">Cosplays</span>
        </nav>

        <div class="mt-10 flex flex-wrap items-end justify-between gap-10">
          <h1 class="hero-word">
            <span class="block font-script text-4xl text-ice">portfolio de</span>
            <span class="mt-1 block font-display text-[clamp(3rem,12vw,8rem)] font-medium leading-none tracking-[0.04em] text-white/90">
              COSPLAYS
            </span>
          </h1>
          <div data-reveal class="max-w-xs lg:text-right">
            <p class="font-display text-5xl text-ice/80">{pad(cosplays.length)}</p>
            <p class="mt-1 text-[0.6rem] uppercase tracking-[0.3em] text-white/40">personajes</p>
            <p class="mt-6 text-[0.72rem] uppercase leading-loose tracking-[0.22em] text-white/60">
              Videojuegos, series y animación, de la idea a la sesión de fotos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 lg:pb-32">
      <div class="mx-auto max-w-7xl px-6">
        <FilterChips target="cosplays-grid" options={categories} label="Filtrar cosplays por categoría" />

        <ul id="cosplays-grid" class="mt-10 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-3 lg:gap-6">
          {
            cosplays.map((cosplay, i) => (
              <li data-category={cosplay.category} data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
                <article class="group relative overflow-hidden border border-white/10 bg-ink-card transition-colors duration-500 hover:border-ice/50">
                  <div class="aspect-[3/4] overflow-hidden">
                    <img
                      src={cosplay.photos[0]}
                      alt={`Cosplay de ${cosplay.name} (${cosplay.source})`}
                      width="900"
                      height="1200"
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
                    />
                  </div>
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent" />
                  <span class="absolute left-4 top-4 text-[0.58rem] tracking-[0.3em] text-white/45 lg:left-5 lg:top-5">
                    {pad(i + 1)}
                  </span>
                  {cosplay.photos.length > 1 && (
                    <span class="absolute right-4 top-4 border border-ice/30 bg-ink/60 px-2.5 py-1 text-[0.52rem] uppercase tracking-[0.26em] text-ice backdrop-blur-sm lg:right-5 lg:top-5">
                      {cosplay.photos.length} fotos
                    </span>
                  )}
                  <div class="absolute inset-x-0 bottom-0 p-5 lg:p-6">
                    <Star class="w-2.5 text-ice/0 transition-all duration-500 group-hover:rotate-90 group-hover:text-ice" />
                    <h2 class="mt-2 font-display text-2xl font-medium uppercase tracking-[0.08em] text-white lg:text-3xl">
                      {cosplay.name}
                    </h2>
                    <p class="mt-1 text-[0.58rem] uppercase tracking-[0.26em] text-white/50">{cosplay.source}</p>
                  </div>
                  <button
                    type="button"
                    data-open="cosplay-viewer"
                    data-slug={cosplay.slug}
                    aria-label={`Ver ${cosplay.name}`}
                    class="absolute inset-0 cursor-zoom-in focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ice"
                  />
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />

  <Lightbox id="cosplay-viewer" label="Cosplay">
    {
      cosplays.map((cosplay, i) => (
        <article
          data-panel={cosplay.slug}
          hidden
          class="flex w-full max-w-6xl flex-col items-center gap-8 lg:flex-row lg:items-end lg:justify-center lg:gap-14"
        >
          <Carousel
            images={cosplay.photos.map((src, n) => ({
              src,
              alt: `Cosplay de ${cosplay.name} (${cosplay.source}), foto ${n + 1}`,
            }))}
            fit="contain"
            class="aspect-[3/4] w-[min(100%,calc(70dvh*0.75))] shrink-0 border border-white/10 bg-ink-card lg:w-[min(100%,calc(84dvh*0.75))]"
          />
          <div class="w-full max-w-sm text-center lg:pb-6 lg:text-left">
            <p class="text-[0.6rem] uppercase tracking-[0.4em] text-steel">
              {pad(i + 1)} / {pad(cosplays.length)}
            </p>
            <h2 class="mt-4 font-display text-5xl font-medium uppercase tracking-[0.08em] text-white lg:text-6xl">
              {cosplay.name}
            </h2>
            <p class="mt-3 text-[0.62rem] uppercase tracking-[0.3em] text-white/55">{cosplay.source}</p>
            <div class="mt-8 flex items-center justify-center gap-4 lg:justify-start">
              <span class="flex items-center gap-2.5 border border-ice/30 px-4 py-2 text-[0.56rem] uppercase tracking-[0.3em] text-ice">
                <Star class="w-2" />
                {cosplay.category}
              </span>
              <span class="text-[0.58rem] uppercase tracking-[0.26em] text-white/40">
                {cosplay.photos.length} {cosplay.photos.length === 1 ? "foto" : "fotos"}
              </span>
            </div>
          </div>
        </article>
      ))
    }
  </Lightbox>
</Layout>
