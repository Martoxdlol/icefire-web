---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Star from "../components/Star.astro";
import FilterChips from "../components/FilterChips.astro";
import Lightbox from "../components/Lightbox.astro";
import Carousel from "../components/Carousel.astro";
import { posts, instagramUrl, type PostType } from "../data/posts";

const categories = [...new Set(posts.map((post) => post.category))];
const pad = (n: number) => String(n).padStart(2, "0");

const typeLabels: Record<PostType, string> = { foto: "Foto", carrusel: "Carrusel", reel: "Reel" };

const icons = {
  play: "M8 5v14l11-7z",
  carousel: "M8 3h11a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm9 18H5a2 2 0 0 1-2-2V7",
};

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("es-AR", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(
    new Date(date),
  );
---

<Layout
  title="Contenido · Ice Fire Cosplay"
  description="Posts, reels y colaboraciones de Camila, Ice Fire Cosplay: cosplay, gaming, tecnología y arte."
>
  <Header />
  <main>
    <section class="relative overflow-hidden pb-14 pt-32 lg:pb-20 lg:pt-40">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-40 left-1/2 h-[30rem] w-[44rem] -translate-x-1/2 rounded-full bg-navy/35 blur-[130px]"></div>
        <Star class="absolute right-[12%] top-[34%] w-2.5 text-ice/40 animate-twinkle" />
        <Star class="absolute bottom-[16%] left-[7%] w-2 text-ice/30 animate-twinkle [animation-delay:1.6s]" />
      </div>

      <div class="relative mx-auto max-w-7xl px-6">
        <nav aria-label="Ruta" class="flex items-center gap-3 text-[0.6rem] uppercase tracking-[0.36em] text-white/40">
          <a href="/" class="transition-colors duration-300 hover:text-ice">Inicio</a>
          <Star class="w-1.5 text-ice/50" />
          <span aria-current="page" class="text-ice/80">Contenido</span>
        </nav>

        <div class="mt-10 flex flex-wrap items-end justify-between gap-10">
          <h1 class="hero-word">
            <span class="block font-script text-4xl text-ice">creadora de</span>
            <span class="mt-1 block font-display text-[clamp(3rem,12vw,8rem)] font-medium leading-none tracking-[0.04em] text-white/90">
              CONTENIDO
            </span>
          </h1>
          <div data-reveal class="max-w-xs lg:text-right">
            <p class="font-display text-5xl text-ice/80">{pad(posts.length)}</p>
            <p class="mt-1 text-[0.6rem] uppercase tracking-[0.3em] text-white/40">publicaciones</p>
            <p class="mt-6 text-[0.72rem] uppercase leading-loose tracking-[0.22em] text-white/60">
              Gaming, tecnología, cosplay y arte, con estética cuidada.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-24 lg:pb-32">
      <div class="mx-auto max-w-7xl px-6">
        <FilterChips target="posts-grid" options={categories} label="Filtrar posts por tipo" allLabel="Todo" />

        <ul id="posts-grid" class="mt-10 grid grid-cols-3 gap-1 sm:gap-2 lg:gap-3">
          {
            posts.map((post) => (
              <li data-category={post.category}>
                <article class="group relative overflow-hidden bg-ink-card">
                  <img
                    src={post.images[0]}
                    alt={post.caption}
                    width="1080"
                    height="1350"
                    loading="lazy"
                    class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                  />
                  {post.type !== "foto" && (
                    <svg
                      viewBox="0 0 24 24"
                      class={`absolute right-2 top-2 w-4 text-white drop-shadow-[0_1px_4px_rgba(0,0,0,0.6)] sm:right-3 sm:top-3 sm:w-5 ${
                        post.type === "reel" ? "fill-current" : "fill-none stroke-current stroke-[1.6]"
                      }`}
                      aria-hidden="true"
                    >
                      <path d={post.type === "reel" ? icons.play : icons.carousel} />
                    </svg>
                  )}
                  <button
                    type="button"
                    data-open="post-viewer"
                    data-slug={post.slug}
                    aria-label={`Ver post: ${post.caption}`}
                    class="absolute inset-0 cursor-pointer focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ice"
                  />
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />

  <Lightbox id="post-viewer" label="Post">
    {
      posts.map((post) => (
        <article
          data-panel={post.slug}
          hidden
          class="grid w-full max-w-lg overflow-hidden border border-white/10 bg-ink-soft lg:w-[min(100%,calc(84dvh*0.8+22rem))] lg:max-w-none lg:grid-cols-[minmax(0,1fr)_22rem]"
        >
          <div class="relative">
            <Carousel
              images={post.images.map((src, n) => ({ src, alt: `${post.caption} (imagen ${n + 1})` }))}
              class="aspect-[4/5] bg-ink-card"
            />
            {post.type === "reel" && (
              <a
                href={post.url ?? instagramUrl}
                target="_blank"
                rel="noopener"
                aria-label="Ver reel en Instagram"
                class="absolute inset-0 m-auto flex size-16 items-center justify-center rounded-full border border-white/30 bg-ink/50 text-ice backdrop-blur-md transition-colors duration-300 hover:border-ice hover:text-ice-bright"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 w-6" aria-hidden="true">
                  <path d={icons.play} />
                </svg>
              </a>
            )}
          </div>

          <div class="flex min-h-0 flex-col">
            <header class="flex items-center gap-3 border-b border-white/10 px-5 py-4">
              <img
                src="/images/hero.jpg"
                alt=""
                loading="lazy"
                class="size-9 rounded-full object-cover object-[46%_48%]"
              />
              <div>
                <p class="text-sm text-white/90">ice_fire.cosplay</p>
                <p class="mt-0.5 text-[0.55rem] uppercase tracking-[0.26em] text-steel">
                  {post.category} · {typeLabels[post.type]}
                </p>
              </div>
            </header>

            <div class="flex-1 overflow-y-auto px-5 py-5">
              <p class="text-[0.92rem] leading-relaxed text-white/75">{post.caption}</p>
            </div>

            <footer class="border-t border-white/10 px-5 py-4">
              <time datetime={post.date} class="block text-[0.55rem] uppercase tracking-[0.26em] text-white/40">
                {formatDate(post.date)}
              </time>
              <a
                href={post.url ?? instagramUrl}
                target="_blank"
                rel="noopener"
                class="group mt-5 flex items-center justify-between border border-ice/30 px-4 py-3 text-[0.6rem] uppercase tracking-[0.28em] text-ice transition-colors duration-300 hover:bg-ice hover:text-ink"
              >
                Ver en Instagram
                <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </a>
            </footer>
          </div>
        </article>
      ))
    }
  </Lightbox>
</Layout>
