---
import Spark from "./Spark.astro";
import { events, press } from "../data/site";
---

<section id="eventos" class="mx-auto max-w-7xl px-5 py-28 sm:px-8">
  <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
    <div>
      <p data-reveal class="mb-3 flex items-center gap-3 text-[0.7rem] font-medium tracking-[0.35em] text-mist-400 uppercase">
        <Spark class="size-3 text-ice-400" /> Escenarios & Media
      </p>
      <h2 data-reveal style="--reveal-delay: 100ms" class="font-display text-4xl font-bold text-ice-100 sm:text-5xl">
        Eventos & <span class="text-gradient-ice">Jurado</span>
      </h2>
    </div>
    <a
      data-reveal
      style="--reveal-delay: 200ms"
      href="#eventos"
      class="text-[0.75rem] font-medium tracking-[0.25em] text-ice-300 uppercase underline-offset-8 transition-all hover:underline"
    >
      Ver todos los eventos →
    </a>
  </div>

  <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
    <!-- Grilla de fotos de eventos -->
    <div class="grid grid-cols-3 gap-3 sm:gap-4">
      {
        events.images.map((src, i) => (
          <img
            data-reveal
            style={`--reveal-delay: ${i * 70}ms`}
            src={src}
            alt={`Ice Fire Cosplay en evento ${i + 1}`}
            class={`w-full rounded-sm object-cover transition-transform duration-500 hover:scale-[1.03] ${
              i === 0 ? "col-span-2 row-span-2 aspect-square" : "aspect-square"
            }`}
            loading="lazy"
            width="600"
            height="600"
          />
        ))
      }
    </div>

    <div class="flex flex-col justify-between gap-10">
      <!-- Roles en eventos -->
      <ul class="space-y-4">
        {
          events.services.map((s, i) => (
            <li
              data-reveal
              style={`--reveal-delay: ${i * 100}ms`}
              class="group flex items-center gap-5 rounded-sm border border-white/8 bg-night-850/60 px-6 py-5 transition-colors hover:border-ice-500/40"
            >
              <Spark class="size-5 shrink-0 text-ice-500/60 transition-colors group-hover:text-ice-300" />
              <div>
                <h3 class="font-display font-semibold text-ice-100">{s.title}</h3>
                <p class="text-sm font-light text-mist-400">{s.detail}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <!-- Prensa -->
      <div id="prensa" data-reveal class="rounded-sm border border-white/8 bg-night-850/60 p-8">
        <h3 class="font-display mb-6 text-2xl font-semibold text-ice-100">
          Prensa & <span class="text-gradient-ice">Media</span>
        </h3>
        <ul class="flex flex-wrap gap-x-8 gap-y-4">
          {
            press.map((medium) => (
              <li class="font-display text-lg text-ice-100/50 transition-colors hover:text-ice-300">{medium}</li>
            ))
          }
        </ul>
        <a
          href="#prensa"
          class="mt-7 inline-block text-[0.75rem] font-medium tracking-[0.25em] text-ice-300 uppercase underline-offset-8 transition-all hover:underline"
        >
          Ver más en prensa →
        </a>
      </div>
    </div>
  </div>
</section>
