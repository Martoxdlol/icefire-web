---
import SocialIcon from "./SocialIcon.astro";

// TODO: completar los links reales de TikTok, YouTube y Twitch
const socials = [
  { name: "instagram", label: "Instagram", href: "https://www.instagram.com/ice_fire.cosplay/" },
  { name: "tiktok", label: "TikTok", href: "#" },
  { name: "youtube", label: "YouTube", href: "#" },
  { name: "twitch", label: "Twitch", href: "#" },
] as const;

const { class: className = "" } = Astro.props;
---

<ul class={`flex items-center gap-5 ${className}`}>
  {
    socials.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="noopener"
          aria-label={s.label}
          class="block text-white/50 transition-colors duration-300 hover:text-ice"
        >
          <SocialIcon name={s.name} class="w-[18px]" />
        </a>
      </li>
    ))
  }
</ul>
