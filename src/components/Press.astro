---
import Star from "./Star.astro";

const events = [1, 2, 3, 4, 5, 6].map((n) => ({
  img: `/images/events/event-${n}.svg`,
  alt: `Camila como jurado e invitada, evento ${n}`,
}));

const press = [
  { name: "Clarín", class: "font-display text-2xl font-bold italic" },
  { name: "TELEFE", class: "text-lg font-extrabold tracking-[0.2em]" },
  { name: "TN", class: "font-display text-3xl font-bold" },
  { name: "infobae", class: "text-lg font-bold lowercase tracking-tight" },
  { name: "Canal 9", class: "text-lg font-semibold tracking-[0.12em]" },
  { name: "La Opinión", class: "font-display text-xl font-medium italic" },
];

const timeline = [
  { year: "2024", title: "Martín Fierro Digital", note: "Cosmaker del Año" },
  { year: "2024", title: "Argentina Game Show", note: "1er puesto — Cosplay" },
  { year: "2023", title: "Xbox · Hellblade II", note: "Campaña oficial" },
  { year: "2023", title: "Guerrilla Games", note: "Aloy cosplay compartido" },
  { year: "2022", title: "Invitada internacional", note: "Eventos en LATAM" },
];
---

<section id="eventos" class="scroll-mt-16 border-t border-white/5 bg-ink-soft">
  <div
    class="mx-auto grid max-w-7xl gap-14 px-6 py-24 lg:grid-cols-[1.2fr_1fr_1.1fr] lg:gap-12 lg:py-32"
  >
    <!-- Eventos & jurado -->
    <div data-reveal>
      <h2 class="flex items-center gap-3 text-[0.68rem] uppercase tracking-[0.4em] text-white/70">
        Eventos <span class="text-ice">&</span> Jurado <Star class="w-2 text-ice/70" />
      </h2>
      <div class="mt-8 grid grid-cols-3 gap-2">
        {
          events.map((event, i) => (
            <div
              class="group overflow-hidden border border-white/10"
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <img
                src={event.img}
                alt={event.alt}
                width="800"
                height="520"
                loading="lazy"
                class="aspect-[4/3] w-full object-cover opacity-80 transition duration-500 group-hover:scale-105 group-hover:opacity-100"
              />
            </div>
          ))
        }
      </div>
      <a
        href="#"
        class="group mt-8 inline-flex items-center gap-2 text-[0.62rem] uppercase tracking-[0.3em] text-white/50 transition-colors duration-300 hover:text-ice"
      >
        Ver todos los eventos
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

    <!-- Prensa & media -->
    <div id="prensa" class="scroll-mt-24 lg:border-x lg:border-white/8 lg:px-10" data-reveal style="--reveal-delay:120ms">
      <h2 class="flex items-center gap-3 text-[0.68rem] uppercase tracking-[0.4em] text-white/70">
        Prensa <span class="text-ice">&</span> Media <Star class="w-2 text-ice/70" />
      </h2>
      <div class="mt-8 grid grid-cols-2 gap-2">
        {
          press.map((medium) => (
            <div class="flex min-h-24 items-center justify-center border border-white/10 px-4 py-6 text-white/45 transition-colors duration-500 hover:border-ice/40 hover:text-white/85">
              <span class={medium.class}>{medium.name}</span>
            </div>
          ))
        }
      </div>
      <a
        href="#"
        class="group mt-8 inline-flex items-center gap-2 text-[0.62rem] uppercase tracking-[0.3em] text-white/50 transition-colors duration-300 hover:text-ice"
      >
        Ver más en prensa
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

    <!-- Trayectoria -->
    <div data-reveal style="--reveal-delay:240ms">
      <h2 class="flex items-center gap-3 text-[0.68rem] uppercase tracking-[0.4em] text-white/70">
        Trayectoria <Star class="w-2 text-ice/70" />
      </h2>
      <ol class="mt-8 space-y-7 border-l border-white/10 pl-7">
        {
          timeline.map((item) => (
            <li class="relative">
              <Star class="absolute -left-[35px] top-1.5 w-3.5 bg-ink-soft py-0.5 text-ice" />
              <p class="font-display text-2xl font-medium text-ice">{item.year}</p>
              <p class="mt-1 text-[0.7rem] uppercase tracking-[0.24em] text-white/80">{item.title}</p>
              <p class="mt-0.5 text-[0.62rem] uppercase tracking-[0.2em] text-white/40">{item.note}</p>
            </li>
          ))
        }
      </ol>
      <a
        href="#"
        class="group mt-8 inline-flex items-center gap-2 text-[0.62rem] uppercase tracking-[0.3em] text-white/50 transition-colors duration-300 hover:text-ice"
      >
        Ver mi trayectoria completa
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</section>
