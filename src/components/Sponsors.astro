---
import Star from "./Star.astro";

// Wordmarks tipográficos; reemplazar por los logos oficiales cuando estén los assets
const brands = [
  { name: "PRINTALOT", class: "font-bold tracking-[0.1em]" },
  { name: "ETERNA", class: "font-light tracking-[0.42em]" },
  { name: "URGAME", class: "font-black italic tracking-tight" },
  { name: "VISIÓN 3D", class: "font-semibold tracking-[0.2em]" },
  { name: "JBL", class: "font-extrabold tracking-[0.08em]" },
  { name: "XBOX", class: "font-bold tracking-[0.18em]" },
  { name: "AORUS", class: "font-semibold italic tracking-[0.3em]" },
  { name: "AGS", class: "font-black tracking-[0.16em]" },
  { name: "SHARKOON", class: "font-bold tracking-[0.2em]" },
  { name: "BANIFOX", class: "font-semibold tracking-[0.14em]" },
  { name: "GFZN", class: "font-black italic tracking-[0.24em]" },
  { name: "G-BUNKER", class: "font-bold tracking-[0.12em]" },
  { name: "OLGA", class: "font-extrabold tracking-[0.3em]" },
  { name: "ABSTRACT", class: "font-semibold tracking-[0.26em]" },
];
---

<section aria-label="Sponsors y partners" class="relative overflow-hidden border-y border-ice/20 bg-ink-soft py-16">
  <!-- Halo azul que separa la banda del resto de la página -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute left-1/2 top-1/2 h-[120%] w-[70%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-navy/25 blur-[110px]"></div>
  </div>

  <p
    class="relative flex items-center justify-center gap-4 text-[0.72rem] uppercase tracking-[0.5em] text-ice"
    data-reveal
  >
    <span class="hidden h-px w-16 bg-gradient-to-r from-transparent to-ice/50 sm:block"></span>
    <Star class="w-2.5 text-ice/80 animate-twinkle" />
    Sponsors / Partners
    <Star class="w-2.5 text-ice/80 animate-twinkle [animation-delay:1.2s]" />
    <span class="hidden h-px w-16 bg-gradient-to-l from-transparent to-ice/50 sm:block"></span>
  </p>

  <div
    class="relative mt-10 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]"
  >
    <div class="flex w-max items-center gap-20 animate-marquee hover:[animation-play-state:paused]">
      {
        [false, true].map((clone) => (
          <ul class="flex items-center gap-20" aria-hidden={clone}>
            {brands.map((brand) => (
              <li
                class={`whitespace-nowrap text-2xl text-white/60 transition-colors duration-300 hover:text-ice-bright ${brand.class}`}
              >
                {brand.name}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>
