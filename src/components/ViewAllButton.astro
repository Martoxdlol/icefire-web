---
import Star from "./Star.astro";

interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className = "" } = Astro.props;
---

<div class={`flex justify-center ${className}`} data-reveal>
  <a
    href={href}
    class="group inline-flex items-center gap-4 border border-ice/40 px-10 py-5 text-[0.8rem] uppercase tracking-[0.34em] text-ice transition-colors duration-300 hover:bg-ice hover:text-ink sm:px-14 sm:py-6 sm:text-[0.9rem]"
  >
    <Star class="w-3.5 transition-transform duration-500 group-hover:rotate-90" />
    {label}
    <span class="text-base transition-transform duration-300 group-hover:translate-x-1.5">→</span>
  </a>
</div>
