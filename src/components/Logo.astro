---
import Spark from "./Spark.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<a href="#top" class={`group inline-flex items-center gap-3 ${className}`} aria-label="Ice Fire Cosplay — inicio">
  <span class="relative grid size-9 place-items-center">
    <Spark class="size-9 text-ice-300 transition-transform duration-500 group-hover:rotate-90" />
    <span class="absolute size-1.5 rotate-45 bg-night-900"></span>
  </span>
  <span class="flex flex-col leading-none">
    <span class="font-display text-xl font-bold tracking-[0.18em] text-ice-200">ICE</span>
    <span class="mt-0.5 text-[0.55rem] font-medium tracking-[0.5em] text-mist-400 uppercase">Cosplay</span>
  </span>
</a>
