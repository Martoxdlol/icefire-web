---
import Spark from "./Spark.astro";
import { award, timeline } from "../data/site";
---

<section id="premios" class="relative overflow-hidden border-y border-white/5 bg-night-950 py-28">
  <!-- Halo dorado del premio -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute top-1/4 left-1/2 size-[36rem] -translate-x-1/2 rounded-full bg-gold-500/8 blur-[120px]"></div>
  </div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-16 px-5 sm:px-8 lg:grid-cols-[1fr_1.1fr]">
    <div data-reveal class="relative mx-auto w-full max-w-sm">
      <div class="absolute -inset-3 rounded-sm border border-gold-400/20" aria-hidden="true"></div>
      <img
        src="/images/award.svg"
        alt="Premio Martín Fierro Digital 2024 — Cosmaker del Año"
        class="relative aspect-[10/13] w-full rounded-sm object-cover"
        loading="lazy"
        width="1000"
        height="1300"
      />
      <Spark class="twinkle absolute -top-4 -left-4 size-8 text-gold-400" />
    </div>

    <div>
      <p data-reveal class="mb-3 flex items-center gap-3 text-[0.7rem] font-medium tracking-[0.35em] text-gold-400 uppercase">
        <Spark class="size-3" /> {award.label}
      </p>
      <h2 data-reveal style="--reveal-delay: 100ms" class="font-display text-4xl leading-tight font-bold sm:text-5xl">
        <span class="text-ice-100">{award.title}</span>
        <span class="text-gradient-gold mt-2 block text-3xl sm:text-4xl">{award.subtitle}</span>
      </h2>
      <p data-reveal style="--reveal-delay: 200ms" class="mt-6 max-w-lg text-lg leading-relaxed font-light text-ice-100/70">
        {award.copy}
      </p>
      <a
        data-reveal
        style="--reveal-delay: 300ms"
        href="#premios"
        class="mt-8 inline-block rounded-full border border-gold-400/50 px-8 py-3.5 text-[0.8rem] font-medium tracking-[0.2em] text-gold-300 uppercase transition-all hover:bg-gold-400 hover:text-night-950"
      >
        {award.cta}
      </a>

      <!-- Trayectoria -->
      <ol class="mt-14 border-l border-white/10">
        {
          timeline.map((item, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 80}ms`} class="relative pb-7 pl-8 last:pb-0">
              <span class="absolute top-1.5 -left-[5px] size-2.5 rotate-45 bg-ice-400" aria-hidden="true" />
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <span class="font-display text-sm font-semibold text-ice-300">{item.year}</span>
                <span class="font-medium text-ice-100">{item.title}</span>
                <span class="text-sm font-light text-mist-400">{item.detail}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
