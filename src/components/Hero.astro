---
import Spark from "./Spark.astro";
import { hero, socials, award } from "../data/site";
---

<section id="top" class="relative flex min-h-screen items-center overflow-hidden pt-24 pb-16">
  <!-- Atmósfera: glow de hielo arriba a la izquierda, brasa abajo a la derecha -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-40 -left-40 size-[42rem] rounded-full bg-ice-600/15 blur-[130px]"></div>
    <div class="absolute -right-48 -bottom-48 size-[38rem] rounded-full bg-ember-600/10 blur-[130px]"></div>
    <div
      class="absolute inset-0 opacity-[0.35]"
      style="background-image: radial-gradient(rgba(179,216,240,0.08) 1px, transparent 1px); background-size: 42px 42px;"
    >
    </div>
    <Spark class="twinkle absolute top-[18%] left-[8%] size-4 text-ice-300/60" />
    <Spark class="twinkle absolute top-[64%] left-[30%] size-2.5 text-ice-300/40" style="animation-delay: 1.1s" />
    <Spark class="twinkle absolute top-[26%] right-[14%] size-3 text-ember-300/50" style="animation-delay: 2s" />
  </div>

  <div class="relative mx-auto grid w-full max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <p
        data-reveal
        class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.75rem] font-medium tracking-[0.3em] text-mist-400 uppercase"
      >
        {
          hero.roles.map((role, i) => (
            <>
              {i > 0 && <Spark class="size-2 text-ice-500/70" />}
              <span>{role}</span>
            </>
          ))
        }
      </p>

      <h1 class="font-display leading-[0.95] font-bold">
        <span data-reveal style="--reveal-delay: 120ms" class="text-gradient-ice block text-[clamp(4.5rem,13vw,10rem)]">
          ICE
        </span>
        <span
          data-reveal
          style="--reveal-delay: 260ms"
          class="text-gradient-ember block text-[clamp(4.5rem,13vw,10rem)] lg:translate-x-16"
        >
          FIRE
        </span>
      </h1>

      <p
        data-reveal
        style="--reveal-delay: 400ms"
        class="font-accent mt-8 max-w-md text-2xl leading-snug text-ice-100/80 italic"
      >
        “{hero.copy}”
      </p>

      <div data-reveal style="--reveal-delay: 540ms" class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="#portfolio"
          class="rounded-full bg-ice-300 px-8 py-3.5 text-[0.8rem] font-semibold tracking-[0.2em] text-night-950 uppercase transition-all hover:bg-ice-200 hover:shadow-[0_0_35px_rgba(179,216,240,0.35)]"
        >
          Ver portfolio
        </a>
        <a
          href="#premios"
          class="rounded-full border border-white/15 px-8 py-3.5 text-[0.8rem] font-medium tracking-[0.2em] text-ice-100/80 uppercase transition-colors hover:border-ice-400 hover:text-ice-300"
        >
          Conocé más
        </a>
      </div>

      <div data-reveal style="--reveal-delay: 660ms" class="mt-12 flex items-center gap-5">
        {
          socials.map((s) => (
            <a
              href={s.href}
              aria-label={s.label}
              class="grid size-10 place-items-center rounded-full border border-white/10 text-[0.7rem] font-semibold tracking-widest text-ice-100/60 transition-all hover:border-ice-400 hover:text-ice-300"
            >
              {s.short}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Retrato enmarcado con badge del premio -->
    <div data-reveal style="--reveal-delay: 300ms" class="relative mx-auto w-full max-w-sm lg:max-w-none">
      <div class="float relative">
        <div class="absolute -inset-3 rounded-sm border border-ice-400/20" aria-hidden="true"></div>
        <img
          src="/images/hero.svg"
          alt="Ice Fire Cosplay — retrato"
          class="relative aspect-[10/13] w-full rounded-sm object-cover shadow-[0_40px_80px_-20px_rgba(0,0,0,0.8)]"
          width="1000"
          height="1300"
        />
        <Spark class="absolute -top-5 -right-5 size-10 text-ice-300" />
        <div
          class="absolute -bottom-6 -left-6 flex items-center gap-3 rounded-sm border border-gold-400/30 bg-night-850/95 px-5 py-4 backdrop-blur"
        >
          <Spark class="size-6 shrink-0 text-gold-400" />
          <div class="leading-tight">
            <p class="text-[0.65rem] tracking-[0.25em] text-mist-400 uppercase">{award.title}</p>
            <p class="font-display text-sm font-semibold text-gold-300">{award.subtitle}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-center">
    <p class="mb-2 text-[0.6rem] tracking-[0.4em] text-mist-400 uppercase">Scroll</p>
    <div class="scroll-cue"></div>
  </div>
</section>
