---
import Star from "./Star.astro";
import SocialLinks from "./SocialLinks.astro";

const roles = ["Cosplayer", "Content Creator", "Concept Artist", "Judge"];
---

<section id="inicio" class="relative flex min-h-svh flex-col overflow-hidden pt-16">
  <!-- Atmósfera -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute left-1/2 top-[-25%] h-[70vh] w-[95vw] -translate-x-1/2 rounded-full bg-ice/10 blur-[120px]"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink to-transparent"></div>
    <Star class="absolute right-[9%] top-[20%] w-3 text-ice/60 animate-twinkle" />
    <Star class="absolute left-[13%] top-[34%] w-2 text-ice/40 animate-twinkle [animation-delay:1.1s]" />
    <Star class="absolute left-[7%] bottom-[24%] w-2.5 text-ice/30 animate-twinkle [animation-delay:2.3s]" />
    <Star class="absolute right-[22%] bottom-[30%] w-2 text-ice/50 animate-twinkle [animation-delay:0.6s]" />
  </div>

  <!-- Titular gigante, detrás del retrato -->
  <h1
    class="pointer-events-none absolute inset-x-0 top-[15vh] z-0 flex items-start justify-between px-[4vw] lg:top-[17vh]"
  >
    <span
      class="hero-word font-display text-[clamp(4.2rem,16vw,15rem)] font-medium leading-[0.85] tracking-[0.02em] text-ice/90"
      >ICE</span
    >
    <Star class="mt-[5vw] hidden w-[2.6vw] max-w-9 shrink-0 text-ice/70 animate-twinkle sm:block" />
    <span
      class="hero-word font-display text-[clamp(4.2rem,16vw,15rem)] font-medium leading-[0.85] tracking-[0.02em] text-ice/90 [animation-delay:0.15s]"
      >FIRE</span
    >
  </h1>

  <!-- Retrato + columnas laterales -->
  <div
    class="relative z-10 mx-auto mt-auto grid w-full max-w-7xl items-end gap-10 px-6 pb-16 lg:grid-cols-[1fr_minmax(280px,430px)_1fr] lg:gap-8 lg:pb-20"
  >
    <div class="order-2 lg:order-none lg:pb-10" data-reveal>
      <ul class="space-y-2.5">
        {
          roles.map((role) => (
            <li class="flex items-center gap-3 text-[0.7rem] uppercase tracking-[0.34em] text-white/60">
              <Star class="w-2 text-ice/70" />
              {role}
            </li>
          ))
        }
      </ul>
      <a
        href="#cosplays"
        class="group mt-9 inline-flex items-center gap-3 border border-white/25 px-7 py-3.5 text-[0.66rem] uppercase tracking-[0.32em] text-white/80 transition-colors duration-300 hover:border-ice hover:text-ice"
      >
        Ver portfolio
        <Star class="w-2.5 transition-transform duration-500 group-hover:rotate-90" />
      </a>
    </div>

    <div class="order-1 mt-[16vh] lg:order-none lg:mt-[20vh]">
      <img
        src="/images/hero.svg"
        alt="Camila, Ice Fire Cosplay, retrato en personaje"
        width="1000"
        height="1300"
        class="w-full [mask-image:linear-gradient(to_bottom,black_75%,transparent)]"
        fetchpriority="high"
      />
    </div>

    <div class="order-3 lg:justify-self-end lg:pb-10 lg:text-right" data-reveal>
      <p class="max-w-xs text-[0.72rem] leading-loose tracking-[0.22em] text-white/65 uppercase lg:ml-auto">
        Transformo personajes en experiencias reales combinando arte, performance y narrativa.
      </p>
      <a
        href="#premios"
        class="mt-6 inline-block border-b border-ice/40 pb-1 text-[0.64rem] uppercase tracking-[0.3em] text-ice/90 transition-colors duration-300 hover:border-ice hover:text-ice-bright"
      >
        Conocé más
      </a>
      <SocialLinks class="mt-8 lg:justify-end" />
    </div>
  </div>

  <!-- Indicador de scroll -->
  <div
    class="absolute bottom-24 right-6 hidden items-center gap-3 lg:flex"
    style="writing-mode: vertical-rl"
    aria-hidden="true"
  >
    <span class="text-[0.58rem] uppercase tracking-[0.5em] text-white/35">Scroll</span>
    <span class="block h-14 w-px bg-gradient-to-b from-white/40 to-transparent animate-float"></span>
  </div>
</section>
