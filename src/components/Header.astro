---
import Logo from "./Logo.astro";
import Star from "./Star.astro";

const links = [
  { href: "#cosplays", label: "Cosplays" },
  { href: "#premios", label: "Premios" },
  { href: "#eventos", label: "Eventos" },
  { href: "#prensa", label: "Prensa" },
  { href: "#contenido", label: "Contenido" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-ink/70 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 lg:px-8">
    <Logo />
    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-[0.66rem] uppercase tracking-[0.3em] text-white/55 transition-colors duration-300 hover:text-ice"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    {/* TODO: link real de Cafecito */}
    <a
      href="#"
      class="group inline-flex items-center gap-2 rounded-full border border-ice/30 px-5 py-2 text-[0.62rem] uppercase tracking-[0.28em] text-ice transition-colors duration-300 hover:bg-ice hover:text-ink"
    >
      <Star class="w-2.5 transition-transform duration-500 group-hover:rotate-90" />
      Cafecito
    </a>
  </div>
</header>
