---
import Logo from "./Logo.astro";
import { nav } from "../data/site";
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-night-900/70 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3 sm:px-8">
    <Logo />
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegación principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-[0.8rem] font-medium tracking-[0.18em] text-ice-100/70 uppercase transition-colors hover:text-ice-300"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a
      href="#contacto"
      class="hidden rounded-full border border-ember-500/60 px-5 py-2 text-[0.8rem] font-medium tracking-[0.18em] text-ember-300 uppercase transition-all hover:bg-ember-500 hover:text-night-950 sm:inline-block"
    >
      Cafecito
    </a>
  </div>
</header>
